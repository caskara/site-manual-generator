# ============================================================
# Site Manual Generator - 配置示例
# 复制此文件为 .env，填入你的配置
# ============================================================

# ---------- LLM 配置（必填） ----------
# 提供商：openai（所有兼容 OpenAI API 的都用这个）
SMG_LLM_PROVIDER=openai

# API 基础地址（DeepSeek 示例，国内推荐）
SMG_LLM_BASE_URL=https://api.deepseek.com/v1

# 你的 API Key
SMG_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 模型名称
SMG_LLM_MODEL=deepseek-chat

# ---------- 其他 LLM 配置示例（取消注释使用） ----------
# OpenAI 官方：
# SMG_LLM_BASE_URL=https://api.openai.com/v1
# SMG_LLM_API_KEY=sk-xxxxxxxx
# SMG_LLM_MODEL=gpt-4o-mini

# 通义千问：
# SMG_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# SMG_LLM_API_KEY=sk-xxxxxxxx
# SMG_LLM_MODEL=qwen-plus

# Ollama 本地模型：
# SMG_LLM_BASE_URL=http://localhost:11434/v1
# SMG_LLM_API_KEY=ollama
# SMG_LLM_MODEL=qwen2.5:7b

# ---------- 代理配置（可选，需要时取消注释） ----------
# SMG_LLM_PROXY=http://127.0.0.1:7890

# ---------- 爬虫配置（可选） ----------
# 浏览器是否无头模式（true/false）
# SMG_CRAWLER_HEADLESS=true
# 等待页面加载的方式：domcontentloaded / load / networkidle
# SMG_CRAWLER_WAIT_UNTIL=domcontentloaded
